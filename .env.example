APP_ENV=development
APP_NAME=jiandco-api
APP_PORT=8080
APP_TIMEZONE=Asia/Jakarta

DATABASE_URL=postgres://postgres:postgres@localhost:5432/jiandco_db?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10

JWT_SECRET=replace-with-a-random-secret-at-least-32-chars
JWT_ISSUER=jiandco-api
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=168h

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=jiandco
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=

SEED_DEVELOPER_NAME=Developer
SEED_DEVELOPER_USERNAME=developer
SEED_DEVELOPER_EMAIL=developer@jiandco.local
SEED_DEVELOPER_PASSWORD=
